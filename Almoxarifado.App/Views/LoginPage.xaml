<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Almoxarifado.App.Views.LoginPage"
             NavigationPage.HasNavigationBar="False">

    <Grid BackgroundColor="#F4F6F8">
        <ScrollView VerticalOptions="Center">

            <Border Margin="20"
                    Padding="30,40"
                    MaximumWidthRequest="450"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Stroke="{StaticResource Primary}"
                    StrokeThickness="1"
                    BackgroundColor="White">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="#1A3160" Offset="0,15" Radius="40" Opacity="0.08" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">

                    <Label Text="AlmoxarifadoSG"
                           FontSize="36"
                           FontAttributes="Bold"
                           TextColor="#1A3160"
                           HorizontalOptions="Center" 
                           CharacterSpacing="1"/>

                    <Label Text="Faça login para solicitar as peças"
                           FontSize="15"
                           TextColor="#6B7C93"
                           HorizontalOptions="Center"
                           Margin="0,0,0,10"/>

                    <Border Stroke="{StaticResource Primary}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="#FAFAFA"
                            HeightRequest="50">
                        <Entry Text="{Binding Email}"
                               Placeholder="Usuário ou Crachá"
                               PlaceholderColor="{StaticResource Gray400}"
                               TextColor="{StaticResource Black}"
                               FontSize="15"
                               Keyboard="Email"
                               ReturnType="Next"
                               VerticalOptions="Center"
                               Margin="15,0"/>
                    </Border>

                    <Border Stroke="{StaticResource Primary}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="#FAFAFA"
                            HeightRequest="50">
                        <Grid ColumnDefinitions="*, Auto">
                            <Entry Grid.Column="0"
                                   x:Name="EntrySenha"
                                   Text="{Binding Password}"
                                   Placeholder="Senha"
                                   PlaceholderColor="#8C9AA9"
                                   TextColor="#1E3A60"
                                   IsPassword="True"
                                   ReturnType="Done"
                                   FontSize="16"
                                   VerticalOptions="Center"
                                   Margin="15,0"/>

                            <ImageButton x:Name="BtnToggleSenha"
                                     Grid.Column="1"
                                     Source="eye_closed.png"
                                     HeightRequest="24"
                                     WidthRequest="24"
                                     VerticalOptions="Center"
                                     HorizontalOptions="End"
                                     Margin="0,0,10,0"
                                     BackgroundColor="Transparent"
                                     Clicked="ToggleSenha_Clicked"/>
                        </Grid>
                    </Border>

                    <Button Text="Entrar no Sistema"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            FontSize="20"
                            HeightRequest="55"
                            CornerRadius="16"
                            Margin="0,15,0,0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2A4D85" Offset="0.0" />
                                <GradientStop Color="#1A3160" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Shadow>
                            <Shadow Brush="#1A3160" Offset="0,8" Radius="15" Opacity="0.4" />
                        </Button.Shadow>
                    </Button>

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource Primary}"
                                       HorizontalOptions="Center" />

                    <HorizontalStackLayout HorizontalOptions="Center" Margin="0,10,0,0" Spacing="5">
                        <Label Text="Não tem uma conta?" 
                               TextColor="#6B7C93" 
                               FontSize="15"/>
                        <Label Text="Cadastre-se aqui" 
                               TextColor="#1A3160" 
                               FontAttributes="Bold" 
                               TextDecorations="Underline"
                               FontSize="15">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToCadastroCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>