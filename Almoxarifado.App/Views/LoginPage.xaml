<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Almoxarifado.App.ViewModels"
             x:Class="Almoxarifado.App.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <VerticalStackLayout Spacing="25" 
                         Padding="30" 
                         VerticalOptions="Center">

        <Label Text="Almoxarifado SG"
               FontSize="32"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="#2B0B98" />

        <Label Text="Faça login para solicitar peças"
               FontSize="16"
               HorizontalOptions="Center"
               TextColor="Gray"
               Margin="0, -15, 0, 20"/>

        <Entry Text="{Binding Username}"
               Placeholder="E-mail ou Crachá"
               Keyboard="Email"
               ClearButtonVisibility="WhileEditing" 
               TextColor="Black"/>

        <Entry Text="{Binding Password}"
               Placeholder="Senha"
               IsPassword="True"
               ClearButtonVisibility="WhileEditing" 
               TextColor="Black"/>

        <Button Text="ENTRAR"
                Command="{Binding LoginCommand}"
                IsEnabled="{Binding IsNotBusy}"
                FontAttributes="Bold"
                CornerRadius="8"
                BackgroundColor="#2B0B98"
                TextColor="White"
                HeightRequest="50"
                Margin="0, 15, 0, 0" />

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="#2B0B98"
                           HorizontalOptions="Center" />

    </VerticalStackLayout>
</ContentPage>