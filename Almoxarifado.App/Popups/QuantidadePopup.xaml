<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Almoxarifado.App.Popups.QuantidadePopup"
               Color="Transparent">

    <Border BackgroundColor="{StaticResource White}" Padding="24" WidthRequest="320" HorizontalOptions="Center" VerticalOptions="Center">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="20" />
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="15">
            <Label Text="Adicionar ao Carrinho" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource BrandPrimary}" HorizontalOptions="Center" />

            <Label x:Name="LblNomePeca" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            <Label x:Name="LblEstoqueDisponivel" FontSize="14" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />

            <Grid ColumnDefinitions="*, Auto, *" ColumnSpacing="20" HorizontalOptions="Center" Margin="0,10">
                <Button Grid.Column="0" Text="-" FontSize="24" FontAttributes="Bold" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="{StaticResource FilterInactiveBackground}" TextColor="{StaticResource BrandPrimary}" Clicked="OnDiminuirClicked" />

                <Label Grid.Column="1" x:Name="LblQuantidade" Text="1" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />

                <Button Grid.Column="2" Text="+" FontSize="24" FontAttributes="Bold" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="{StaticResource BrandPrimary}" TextColor="{StaticResource White}" Clicked="OnAumentarClicked" />
            </Grid>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,15,0,0">
                <Button Grid.Column="0" Text="Cancelar" BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}" FontAttributes="Bold" Clicked="OnCancelarClicked" />
                <Button Grid.Column="1" Text="Confirmar" BackgroundColor="{StaticResource CartButtonColor}" TextColor="{StaticResource White}" FontAttributes="Bold" CornerRadius="10" Clicked="OnConfirmarClicked" />
            </Grid>
        </VerticalStackLayout>
    </Border>

</toolkit:Popup>