<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Almoxarifado.App.Views.GestaoFilaPage"
             Title="Gestão de Fila"
             BackgroundColor="#F5F5F5">

    <CollectionView ItemsSource="{Binding Pedidos}">

        <CollectionView.Header>
            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                               IsVisible="{Binding IsBusy}" 
                               HorizontalOptions="Center" 
                               Margin="0,20,0,0"
                               Color="#2B0B98"/>
        </CollectionView.Header>

        <CollectionView.EmptyView>
            <VerticalStackLayout HorizontalOptions="Center" 
                                 VerticalOptions="Center"
                                 IsVisible="{Binding IsEmpty}"
                                 Margin="0,50,0,0">
                <Label Text="📦" FontSize="64" HorizontalOptions="Center" />
                <Label Text="Fila limpa!" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#333333"/>
                <Label Text="Nenhuma solicitação pendente no momento." TextColor="Gray" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border StrokeShape="RoundRectangle 8" 
                        Stroke="#E0E0E0" 
                        BackgroundColor="White"
                        Padding="15"
                        Margin="0,0,0,10">
                    <VerticalStackLayout>
                        <Label Text="Pedido em andamento..." TextColor="Gray" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>