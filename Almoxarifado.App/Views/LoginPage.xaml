<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Almoxarifado.App.Views.LoginPage"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <VerticalStackLayout Spacing="25" 
                         Padding="30" 
                         VerticalOptions="Center">

        <Label Text="Almoxarifado SG"
               FontSize="32"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="#2B0B98" />

        <Label Text="Faz login para solicitar peças"
               FontSize="16"
               HorizontalOptions="Center"
               TextColor="Gray"
               Margin="0, -15, 0, 20"/>

        <Entry Placeholder="Utilizador ou Crachá"
               Text="{Binding Email}"
               Keyboard="Text"
               ClearButtonVisibility="WhileEditing" 
               TextColor="Black"/>

        <Entry Placeholder="Password"
               Text="{Binding Senha}"
               IsPassword="True"
               ClearButtonVisibility="WhileEditing" 
               TextColor="Black"/>

        <ActivityIndicator IsRunning="{Binding IsBusy}" 
                           IsVisible="{Binding IsBusy}"
                           Color="#2B0B98"
                           HorizontalOptions="Center"/>

        <Button Text="ENTRAR"
                Command="{Binding FazerLoginCommand}"
                FontAttributes="Bold"
                CornerRadius="8"
                BackgroundColor="#2B0B98"
                TextColor="White"
                HeightRequest="50"
                Margin="0, 15, 0, 0" />

    </VerticalStackLayout>
</ContentPage>