<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Almoxarifado.App.Views.DetalheSolicitacaoPage"
             Title="Status da Solicitação"
             BackgroundColor="#F8FAFC">

    <ContentPage.Resources>
        <Color x:Key="CorAzul">#1E3A8A</Color>
        <Color x:Key="CorAzulSuave">#EFF6FF</Color>
        <Color x:Key="CorTextoEscuro">#0F172A</Color>
        <Color x:Key="CorTextoClaro">#64748B</Color>
        <Color x:Key="CorBordaNeutras">#E2E8F0</Color>
        <Color x:Key="CorVermelha">#EF4444</Color>
        <Color x:Key="CorVermelhaSuave">#FEF2F2</Color>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="22">

            <Button Text="← Voltar para o painel" 
                    Command="{Binding VoltarCommand}" 
                    BackgroundColor="Transparent" 
                    TextColor="{StaticResource CorTextoClaro}" 
                    FontSize="14" 
                    FontAttributes="Bold"
                    Padding="0"
                    Margin="0,0,0,-5"
                    HorizontalOptions="Start"/>

            <Border StrokeThickness="1" Stroke="{StaticResource CorBordaNeutras}" BackgroundColor="White" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#0F172A" Opacity="0.04" Offset="0,4" Radius="8" />
                </Border.Shadow>

                <FlexLayout JustifyContent="SpaceBetween" AlignItems="Center">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Solicitação" FontSize="13" TextColor="{StaticResource CorTextoClaro}" FontAttributes="Bold" />
                        <Label Text="{Binding SolicitacaoSelecionada.Id, StringFormat='#{0}'}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource CorTextoEscuro}" />
                    </VerticalStackLayout>

                    <Border BackgroundColor="{StaticResource CorAzulSuave}" StrokeThickness="0" Padding="12,6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Label Text="{Binding SolicitacaoSelecionada.Status}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource CorAzul}" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </FlexLayout>
            </Border>

            <VerticalStackLayout Spacing="8">
                <Label Text="Informações Gerais" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource CorTextoEscuro}" Margin="4,0,0,0"/>

                <Border StrokeThickness="1" Stroke="{StaticResource CorBordaNeutras}" BackgroundColor="White" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Data de Abertura" FontSize="12" TextColor="{StaticResource CorTextoClaro}" FontAttributes="Bold"/>
                            <Label Text="{Binding SolicitacaoSelecionada.CreatedAt, StringFormat='{0:dd/MM/yyyy às HH:mm}'}" FontSize="15" TextColor="{StaticResource CorTextoEscuro}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Colaborador Solicitante" FontSize="12" TextColor="{StaticResource CorTextoClaro}" FontAttributes="Bold"/>
                            <Label Text="{Binding NomeSolicitante}" FontSize="15" TextColor="{StaticResource CorTextoEscuro}" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource CorBordaNeutras}" Margin="0,2" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Justificativa informada" FontSize="12" TextColor="{StaticResource CorTextoClaro}" FontAttributes="Bold" />
                            <Label Text="{Binding SolicitacaoSelecionada.Observacao, TargetNullValue='Nenhuma justificativa inserida.', FallbackValue='Nenhuma justificativa inserida.'}" FontSize="14" TextColor="{StaticResource CorTextoEscuro}" LineHeight="1.2" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Materiais Requisitados" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource CorTextoEscuro}" Margin="4,0,0,0"/>

                <CollectionView ItemsSource="{Binding Itens}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeThickness="1" Stroke="{StaticResource CorBordaNeutras}" BackgroundColor="White" Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding NomeProduto}" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource CorTextoEscuro}" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Sku, StringFormat='SKU {0}'}" FontSize="12" TextColor="{StaticResource CorTextoClaro}" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="1" BackgroundColor="#F1F5F9" StrokeThickness="0" Padding="10,4" VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Quantidade, StringFormat='{0} un'}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource CorTextoEscuro}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <Button Text="Cancelar Solicitação" 
                    BackgroundColor="{StaticResource CorVermelhaSuave}" 
                    TextColor="{StaticResource CorVermelha}" 
                    BorderColor="{StaticResource CorVermelha}"
                    BorderWidth="1"
                    FontAttributes="Bold"
                    CornerRadius="10" 
                    HeightRequest="50" 
                    Margin="0,10,0,20" 
                    Command="{Binding CancelarSolicitacaoCommand}" 
                    IsVisible="{Binding PodeCancelar}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>