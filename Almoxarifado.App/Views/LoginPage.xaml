<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Almoxarifado.App.Views.LoginPage"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <VerticalStackLayout Spacing="25" 
                         Padding="30" 
                         VerticalOptions="Center">

        <Label Text="Almoxarifado SG"
               FontSize="32"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="#2B0B98" />

        <Label Text="Faz login para solicitar peças"
               FontSize="16"
               HorizontalOptions="Center"
               TextColor="Gray"
               Margin="0, -15, 0, 20"/>

        <Entry x:Name="EntryUsuario"
               Placeholder="Utilizador ou Crachá"
               Keyboard="Text"
               ClearButtonVisibility="WhileEditing" 
               TextColor="Black"/>

        <Entry x:Name="EntrySenha"
               Placeholder="Password"
               IsPassword="True"
               ClearButtonVisibility="WhileEditing" 
               TextColor="Black"/>

        <Button Text="ENTRAR"
                FontAttributes="Bold"
                CornerRadius="8"
                BackgroundColor="#2B0B98"
                TextColor="White"
                HeightRequest="50"
                Margin="0, 15, 0, 0"
                Clicked="OnLoginClicked" />

    </VerticalStackLayout>

</ContentPage>