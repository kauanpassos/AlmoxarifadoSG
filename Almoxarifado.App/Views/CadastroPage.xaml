<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Almoxarifado.App.ViewModels"
             x:Class="Almoxarifado.App.Views.CadastroPage"
             x:DataType="viewmodels:CadastroViewModel"
             Title="Cadastro de Usuário"
             BackgroundColor="{StaticResource White}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Entry">
                <Setter Property="ClearButtonVisibility" Value="WhileEditing" />
                <Setter Property="TextColor" Value="{StaticResource Black}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource Gray400}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="{StaticResource Black}" />
                <Setter Property="TitleColor" Value="{StaticResource Gray400}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Black}" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="FontSize" Value="18" />
            </Style>

            <Style x:Key="LinkText" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                <Setter Property="TextDecorations" Value="Underline" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="Margin" Value="0,15,0,20" />
            </Style>
            
            <Style x:Key="InputContainer" TargetType="Border">
                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
                <Setter Property="BackgroundColor" Value="#FAFAFA" />
                <Setter Property="HeightRequest" Value="50" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="#F4F6F8">
        <ScrollView VerticalOptions="CenterAndExpand">
            
            <Border Margin="20"
                    Padding="30,40"
                    MaximumWidthRequest="450"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Stroke="{StaticResource Primary}"
                    StrokeThickness="1"
                    BackgroundColor="White">
                
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="#1A3160" Offset="0,15" Radius="40" Opacity="0.08" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">

                <Image Source="icone_cadastro.png"
                           HeightRequest="80"
                           HorizontalOptions="Center"
                           Margin="0,0,0,10"
                           SemanticProperties.Description="Logotipo do Aplicativo Almoxarifado" />

                    <Label Text="Criar nova conta"
                           FontSize="28"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#1A3160"
                           SemanticProperties.HeadingLevel="Level1" 
                           Margin="0,0,0,15" />

                    <Border Style="{StaticResource InputContainer}">
                        <Entry Placeholder="Nome Completo"
                               Text="{Binding Nome}"
                               ReturnType="Next" 
                               Margin="15,0"/>
                    </Border>

                    <Border Style="{StaticResource InputContainer}">
                        <Entry Placeholder="E-mail Corporativo"
                               Text="{Binding Email}"
                               Keyboard="Email"
                               ReturnType="Next" 
                               Margin="15,0"/>
                    </Border>

                    <Border Style="{StaticResource InputContainer}">
                        <Entry Placeholder="Setor de Trabalho"
                               Text="{Binding Setor}"
                               ReturnType="Next" 
                               Margin="15,0"/>
                    </Border>

                    <Label Text="Tipo de Usuário" TextColor="{StaticResource Gray400}" Margin="0,5,0,-10" />
                    <Border Style="{StaticResource InputContainer}" HeightRequest="-1" Padding="0,5">
                        <Picker ItemsSource="{Binding TiposUsuarios}" 
                                SelectedItem="{Binding Tipo}" 
                                BackgroundColor="Transparent"
                                VerticalOptions="Center"
                                Margin="15,0"/>
                    </Border>

                    <Border Style="{StaticResource InputContainer}">
                        <Grid ColumnDefinitions="*, Auto">
                            <Entry x:Name="EntrySenha"
                                   Placeholder="Senha"
                                   Text="{Binding Senha}"
                                   IsPassword="True"
                                   ReturnType="Next" 
                                   Margin="15,0"/>
                            <ImageButton x:Name="BtnToggleSenha"
                                         Grid.Column="1"
                                         Source="eye_closed.png"
                                         HeightRequest="24"
                                         WidthRequest="24"
                                         VerticalOptions="Center"
                                         HorizontalOptions="End"
                                         Margin="0,0,5,0"
                                         BackgroundColor="Transparent"
                                         Clicked="ToggleSenha_Clicked"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource InputContainer}">
                        <Grid ColumnDefinitions="*, Auto">
                            <Entry x:Name="EntryConfirmarSenha"
                                   Placeholder="Confirmar Senha"
                                   Text="{Binding ConfirmarSenha}"
                                   IsPassword="True"
                                   ReturnType="Done" 
                                   Margin="15,0"/>
                            <ImageButton x:Name="BtnToggleConfirmarSenha"
                                         Grid.Column="1"
                                         Source="eye_closed.png"
                                         HeightRequest="24"
                                         WidthRequest="24"
                                         VerticalOptions="Center"
                                         HorizontalOptions="End"
                                         Margin="0,0,5,0"
                                         BackgroundColor="Transparent"
                                         Clicked="ToggleConfirmarSenha_Clicked"/>
                        </Grid>
                    </Border>

                    <Label Text="{Binding MensagemErro}"
                           TextColor="Red"
                           IsVisible="{Binding TemErro}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <Button Text="Cadastrar"
                            Command="{Binding RegistrarCommand}"
                            TextColor="White"
                            FontSize="18"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            CornerRadius="16"
                            Margin="0,15,0,0">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="Opacity" Value="0.85" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Property="Opacity" Value="0.65" />
                                        <Setter Property="Scale" Value="0.98" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2A4D85" Offset="0.0" />
                                <GradientStop Color="#1A3160" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Shadow>
                            <Shadow Brush="#1A3160" Offset="0,8" Radius="15" Opacity="0.4" />
                        </Button.Shadow>
                    </Button>

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource Primary}"
                                       HorizontalOptions="Center" />

                    <HorizontalStackLayout HorizontalOptions="Center" Margin="0,10,0,0" Spacing="5">
                        <Label Text="Já tem uma conta?" 
                               TextColor="#6B7C93" 
                               FontSize="15"/>
                        <Label Text="Voltar para o Login" 
                               TextColor="#1A3160" 
                               FontAttributes="Bold" 
                               TextDecorations="Underline"
                               FontSize="15">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding VoltarParaLoginCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>
