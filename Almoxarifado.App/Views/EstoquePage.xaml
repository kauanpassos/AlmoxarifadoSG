<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Almoxarifado.App.ViewModels"
             xmlns:controls="clr-namespace:Almoxarifado.App.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Almoxarifado.App.Views.EstoquePage"
             x:DataType="vm:EstoqueViewModel"
             BackgroundColor="{StaticResource PageBackground}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding CarregarEstoqueCommand}" />
    </ContentPage.Behaviors>

    <Grid>
        <Grid RowDefinitions="Auto, *, Auto" BackgroundColor="{StaticResource PageBackground}">

            <VerticalStackLayout Grid.Row="0">

                <controls:HeaderControl Titulo="Estoque" MostrarBotaoVoltar="True" />

                <Border Stroke="{StaticResource InputBorder}" StrokeThickness="1" BackgroundColor="{StaticResource InputBackground}" Margin="28,0,28,16" Padding="13,0,19,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto, *">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center" Margin="0,0,4,0">
                            <BoxView WidthRequest="13" HeightRequest="13" Color="{StaticResource Gray500}" />
                            <BoxView WidthRequest="7" HeightRequest="7" Color="{StaticResource Black}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <Entry Grid.Column="1" 
                               Text="{Binding TermoPesquisa}" 
                               Placeholder="Nome ou Número do Produto" 
                               PlaceholderColor="{StaticResource TextSecondary}" 
                               TextColor="{StaticResource TextSecondary}" 
                               FontSize="15" 
                               BackgroundColor="Transparent" />
                    </Grid>
                </Border>

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="28,0,0,27">
                    <HorizontalStackLayout Spacing="16">

                        <Border BackgroundColor="{StaticResource BrandSecondary}" Stroke="{StaticResource BrandSecondary}" StrokeThickness="1" Padding="9,3">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label Text="Todos" TextColor="{StaticResource White}" FontSize="15" FontAttributes="Bold" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding FiltrarTodosCommand}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border BackgroundColor="{StaticResource FilterInactiveBackground}" Stroke="{StaticResource BrandPrimary}" StrokeThickness="1" Padding="6,5" Margin="0,0,28,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label Text="Indisponível" TextColor="{StaticResource BrandPrimary}" FontSize="15" FontAttributes="Bold" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding FiltrarIndisponivelCommand}" />
                            </Border.GestureRecognizers>
                        </Border>

                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>

            <ActivityIndicator Grid.Row="1" 
                               IsVisible="{Binding EstaCarregando}" 
                               IsRunning="{Binding EstaCarregando}" 
                               Color="{StaticResource BrandPrimary}" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" 
                               ZIndex="2"/>

            <CollectionView Grid.Row="1" ItemsSource="{Binding PecasEstoque}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ItemEstoqueModel">
                        <controls:ItemEstoqueCard />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid Grid.Row="2" HeightRequest="51">
                <Border BackgroundColor="{StaticResource BrandPrimary}" Stroke="{StaticResource BlackBrush}" StrokeThickness="1" Margin="0" Padding="0" />
                <Grid ColumnDefinitions="*, Auto, Auto, *">
                    <BoxView Grid.Column="1" WidthRequest="51" HeightRequest="51" Color="Transparent" Margin="0,0,25,0" />
                    <BoxView Grid.Column="2" WidthRequest="51" HeightRequest="51" Color="Transparent" Margin="25,0,0,0" />
                </Grid>
            </Grid>
        </Grid>

        <Border BackgroundColor="{StaticResource CartButtonColor}" StrokeThickness="0" WidthRequest="100" HeightRequest="50"
                HorizontalOptions="End" VerticalOptions="End" Margin="0,0,25,80"
                IsVisible="{Binding TemItensNoCarrinho}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="25" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{StaticResource BlackBrush}" Offset="0,5" Radius="5" Opacity="0.4" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding IrParaCarrinhoCommand}" />
            </Border.GestureRecognizers>

            <Grid ColumnDefinitions="*, Auto" Padding="12,0">
                <Label Grid.Column="0" Text="Carrinho" TextColor="{StaticResource White}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center"/>
                <Border Grid.Column="1" BackgroundColor="{StaticResource White}" Stroke="{StaticResource CartButtonColor}" StrokeThickness="1" WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="11"/>
                    </Border.StrokeShape>
                    <Label Text="{Binding QuantidadeCarrinho}" TextColor="{StaticResource CartButtonColor}" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

    </Grid>
</ContentPage>