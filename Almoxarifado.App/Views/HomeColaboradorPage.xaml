<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Almoxarifado.App.Views.HomeColaboradorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Almoxarifado.App.ViewModels"
    x:DataType="vm:HomeColaboradorViewModel"
    BackgroundColor="White"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid
            Grid.Row="0"
            BackgroundColor="#1A336E"
            Padding="25,45,25,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label
                Text="Suas Solicitações"
                TextColor="White"
                FontSize="26"
                FontAttributes="Bold"
                VerticalOptions="Center" />

            <Frame
                Grid.Column="1"
                WidthRequest="45"
                HeightRequest="45"
                CornerRadius="22"
                BackgroundColor="White"
                Padding="0"
                HasShadow="False"
                BorderColor="#D9D9D9">

                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding IrParaPerfilCommand}" />
                </Frame.GestureRecognizers>

                <Label
                    Text="{Binding IniciaisUsuario}"
                    TextColor="#1A336E"
                    FontAttributes="Bold"
                    FontSize="16"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Frame>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto,*" Padding="25,20,25,0">

            <Frame
                Grid.Row="0"
                BackgroundColor="#F1F1F1"
                BorderColor="#757575"
                CornerRadius="20"
                Padding="15,10"
                HasShadow="True"
                Margin="0,0,0,18">

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="🔍" FontSize="18" VerticalOptions="Center" />
                    <Entry
                        Grid.Column="1"
                        Text="{Binding TermoPesquisa}"
                        Placeholder="Pesquisar por peça, SKU ou status"
                        PlaceholderColor="#757575"
                        BackgroundColor="Transparent"
                        TextColor="Black" />
                </Grid>
            </Frame>

            <CollectionView Grid.Row="1" ItemsSource="{Binding ListaSolicitacoes}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SolicitacaoModel">
                        <Frame
                            BackgroundColor="White"
                            BorderColor="{Binding CorHexStatus}"
                            CornerRadius="8"
                            Padding="18,15"
                            HasShadow="True"
                            Margin="0,0,0,15">

                            <VerticalStackLayout Spacing="10">

                                <Label
                                    Text="{Binding NomePeca}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="#1A1A1A" />

                                <Label
                                    Text="{Binding Sku, StringFormat='SKU: {0}'}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#757575" />

                                <Grid ColumnDefinitions="*,Auto">

                                    <Label
                                        Text="{Binding Quantidade, StringFormat='{0} un'}"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        VerticalOptions="Center"
                                        TextColor="Black" />

                                    <Button
                                        Grid.Column="1"
                                        Text="{Binding NomeStatus}"
                                        BackgroundColor="{Binding CorHexStatus}"
                                        TextColor="White"
                                        CornerRadius="10"
                                        Padding="20,8"
                                        FontAttributes="Bold" />
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

        <Grid
            Grid.Row="2"
            BackgroundColor="#1A336E"
            Padding="20,10"
            ColumnDefinitions="*,*"
            ColumnSpacing="15">

            <Button
                Text="Nova Solicitação"
                Command="{Binding NovoPedidoCommand}"
                BackgroundColor="White"
                TextColor="#1A336E"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="50" />

            <Button
                Grid.Column="1"
                Text="Estoque"
                Command="{Binding VerEstoqueCommand}"
                BackgroundColor="White"
                TextColor="#1A336E"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="50" />
        </Grid>

    </Grid>
</ContentPage>