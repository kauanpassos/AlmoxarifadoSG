<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Almoxarifado.App.ViewModels"
             xmlns:models="clr-namespace:Almoxarifado.App.Models"
             xmlns:converters="clr-namespace:Almoxarifado.App.Converters"
             x:Class="Almoxarifado.App.Views.HomeColaboradorPage"
             x:DataType="vm:HomeColaboradorViewModel"
             BackgroundColor="#F8FAFC"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StatusToColorConverter x:Key="StatusToColor" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid RowDefinitions="Auto, *, Auto">

            <Grid Grid.Row="0" BackgroundColor="#1E3A8A" Padding="25,45,25,20" ColumnDefinitions="*, Auto">
                <Label Grid.Column="0" Text="Suas Solicitações" TextColor="White" FontSize="26" FontAttributes="Bold" VerticalOptions="Center" />

                <Border Grid.Column="1" WidthRequest="44" HeightRequest="44" BackgroundColor="White" StrokeThickness="1" Stroke="#E2E8F0" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding IrParaPerfilCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding IniciaisUsuario}" TextColor="#1E3A8A" FontAttributes="Bold" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="Auto, Auto, *" Padding="20,20,20,0">

                <Border Grid.Row="0" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="14,0" HeightRequest="46" Margin="0,0,0,14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto, *">
                        <Image Grid.Column="0" VerticalOptions="Center" Margin="0,0,10,0" WidthRequest="18" HeightRequest="18">
                            <Image.Source>
                                <FontImageSource FontFamily="OpenSansRegular" Glyph="🔍" Color="#64748B" Size="16"/>
                            </Image.Source>
                        </Image>
                        <Entry Grid.Column="1" Text="{Binding TermoPesquisa}" Placeholder="Pesquisar por peça, SKU ou status..." PlaceholderColor="#94A3B8" TextColor="#0F172A" VerticalOptions="Center" FontSize="15" BackgroundColor="Transparent" />
                    </Grid>
                </Border>

                <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,0,0,16">
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Todas" Command="{Binding AlterarFiltroCommand}" CommandParameter="Todas" BackgroundColor="#1E3A8A" TextColor="White" CornerRadius="20" HeightRequest="36" Padding="16,0" FontSize="13" FontAttributes="Bold" />
                        <Button Text="Pendentes" Command="{Binding AlterarFiltroCommand}" CommandParameter="Pendente" BackgroundColor="#F97316" TextColor="White" CornerRadius="20" HeightRequest="36" Padding="16,0" FontSize="13" FontAttributes="Bold" />
                        <Button Text="Aprovadas" Command="{Binding AlterarFiltroCommand}" CommandParameter="Aprovada" BackgroundColor="#10B981" TextColor="White" CornerRadius="20" HeightRequest="36" Padding="16,0" FontSize="13" FontAttributes="Bold" />
                        <Button Text="Recusadas" Command="{Binding AlterarFiltroCommand}" CommandParameter="Recusada" BackgroundColor="#EF4444" TextColor="White" CornerRadius="20" HeightRequest="36" Padding="16,0" FontSize="13" FontAttributes="Bold" />
                    </HorizontalStackLayout>
                </ScrollView>

                <CollectionView Grid.Row="2" ItemsSource="{Binding ListaSolicitacoes}" Margin="0,0,0,10">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SolicitacaoModel">
                            <Border BackgroundColor="White" Stroke="{Binding NomeStatus, Converter={StaticResource StatusToColor}}" StrokeThickness="1" Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#0F172A" Opacity="0.04" Offset="0,2" Radius="4" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeColaboradorViewModel}}, Path=AbrirDetalhesSolicitacaoCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding NomeProduto}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Sku, StringFormat='SKU: {0}'}" FontSize="12" TextColor="#64748B" />

                                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center" Margin="0,4,0,0">
                                        <Label Grid.Column="0" Text="{Binding Quantidade, StringFormat='{0} un'}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" TextColor="#0F172A" />
                                        <Border Grid.Column="1" BackgroundColor="{Binding NomeStatus, Converter={StaticResource StatusToColor}}" StrokeThickness="0" Padding="14,6">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding NomeStatus}" TextColor="White" FontSize="12" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <Grid Grid.Row="2" BackgroundColor="#1E3A8A" Padding="20,12">
                <Button Text="Ver Estoque e Fazer Pedido" Command="{Binding VerEstoqueCommand}" BackgroundColor="White" TextColor="#1E3A8A" FontAttributes="Bold" CornerRadius="12" HeightRequest="48" />
            </Grid>
        </Grid>

        <Grid BackgroundColor="#80000000" IsVisible="{Binding IsBusy}" ZIndex="10">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="White" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="44" HeightRequest="44" />
        </Grid>

    </Grid>
</ContentPage>