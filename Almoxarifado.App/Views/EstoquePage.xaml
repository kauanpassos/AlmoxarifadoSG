<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Almoxarifado.App.ViewModels"
             x:Class="Almoxarifado.App.Views.EstoquePage"
             x:DataType="vm:EstoqueViewModel"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto" BackgroundColor="White">

        <VerticalStackLayout Grid.Row="0">

            <Border BackgroundColor="#1A336E" Stroke="Black" StrokeThickness="1" Padding="32,38,32,6" Margin="0,0,0,18">
                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Start">
                    <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center" Margin="0,0,31,0">
                        <BoxView WidthRequest="14" HeightRequest="14" Color="White" />
                        <BoxView WidthRequest="14" HeightRequest="14" Color="White" />
                    </VerticalStackLayout>

                    <Label Grid.Column="1" Text="Estoque" TextColor="White" FontSize="24" FontAttributes="Bold" VerticalOptions="Center" />

                    <Border Grid.Column="2" BackgroundColor="White" Padding="4,8" StrokeThickness="0" VerticalOptions="Center">
                        <Label Text="JS" TextColor="#1A336E" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Stroke="#757575" StrokeThickness="1" BackgroundColor="#F1F1F1" Margin="28,0,28,16" Padding="13,0,19,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto, *">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center" Margin="0,0,4,0">
                        <BoxView WidthRequest="13" HeightRequest="13" Color="Gray" />
                        <BoxView WidthRequest="7" HeightRequest="7" Color="Black" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <Entry Grid.Column="1" Text="{Binding TermoPesquisa}" Placeholder="Pesquisar por Peça, SKU ou Status" PlaceholderColor="#757575" TextColor="#757575" FontSize="15" BackgroundColor="Transparent" />
                </Grid>
            </Border>

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="28,0,0,27">
                <HorizontalStackLayout Spacing="16">
                    <Border BackgroundColor="#254A9A" Stroke="#254A9A" StrokeThickness="1" Padding="9,3">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Label Text="Todos" TextColor="White" FontSize="15" FontAttributes="Bold" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding FiltrarTodosCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border BackgroundColor="#F0F4F8" Stroke="#1A336E" StrokeThickness="1" Padding="11,3">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Label Text="Baixo Estoque" TextColor="#1A336E" FontSize="15" FontAttributes="Bold" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding FiltrarBaixoEstoqueCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border BackgroundColor="#F0F4F8" Stroke="#1A336E" StrokeThickness="1" Padding="6,5" Margin="0,0,28,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Label Text="Indisponível" TextColor="#1A336E" FontSize="15" FontAttributes="Bold" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding FiltrarIndisponivelCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding PecasEstoque}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ItemEstoqueModel">
                    <Border Stroke="#FF9565" StrokeThickness="1" BackgroundColor="White" Margin="28,0,28,20" Padding="0,17,0,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="5" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,4" Radius="4" Opacity="0.25" />
                        </Border.Shadow>

                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="Auto, *" Margin="11,0,11,7" ColumnSpacing="14">
                                <Border Grid.Column="0" WidthRequest="80" HeightRequest="80" BackgroundColor="#D9D9D9" Stroke="#D9D9D9" StrokeThickness="5">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                </Border>

                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding NomePeca}" TextColor="#1A1A1A" FontSize="18" FontAttributes="Bold" Margin="0,0,0,1" />
                                    <Label Text="{Binding Sku}" TextColor="#757575" FontSize="12" FontAttributes="Bold" Margin="0,0,0,8" />

                                    <Border HorizontalOptions="End" BackgroundColor="{Binding CorFundoStatus}" Stroke="{Binding CorBordaStatus}" StrokeThickness="1" Padding="17,8">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>
                                        <Label Text="{Binding TextoStatus}" TextColor="{Binding CorTextoStatus}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="*, *" Margin="13,0,13,5">
                                <Label Grid.Column="0" Text="{Binding Quantidade, StringFormat='{0} un'}" TextColor="Black" FontSize="20" FontAttributes="Bold" HorizontalOptions="Start" />
                                <Label Grid.Column="1" Text="{Binding DataAtualizacao}" TextColor="Black" FontSize="12" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="2" HeightRequest="51">
            <Border BackgroundColor="#1A336E" Stroke="Black" StrokeThickness="1" Margin="0" Padding="0" />
            <Grid ColumnDefinitions="*, Auto, Auto, *">
                <BoxView Grid.Column="1" WidthRequest="51" HeightRequest="51" Color="Transparent" Margin="0,0,25,0" />
                <BoxView Grid.Column="2" WidthRequest="51" HeightRequest="51" Color="Transparent" Margin="25,0,0,0" />
            </Grid>
        </Grid>

    </Grid>
</ContentPage>