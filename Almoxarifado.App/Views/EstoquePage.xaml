<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Almoxarifado.App.ViewModels"
             xmlns:controls="clr-namespace:Almoxarifado.App.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Almoxarifado.App.Views.EstoquePage"
             x:DataType="vm:EstoqueViewModel"
             BackgroundColor="{StaticResource PageBackground}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding CarregarEstoqueCommand}" />
    </ContentPage.Behaviors>

    <Grid>
        <Grid RowDefinitions="Auto, *" BackgroundColor="{StaticResource PageBackground}">

            <VerticalStackLayout Grid.Row="0" Spacing="0">
                <controls:HeaderControl Titulo="Estoque" MostrarBotaoVoltar="True" />

                <Border Stroke="{StaticResource InputBorder}" StrokeThickness="1" BackgroundColor="{StaticResource InputBackground}" Margin="20,0,20,16" Padding="14,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="Auto, *">
                        <Image Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center" Margin="0,0,10,0" WidthRequest="18" HeightRequest="18">
                            <Image.Source>
                                <FontImageSource FontFamily="OpenSansRegular" Glyph="🔍" Color="{StaticResource Gray500}" Size="16"/>
                            </Image.Source>
                        </Image>

                        <Entry Grid.Column="1" 
                               Text="{Binding TermoPesquisa}" 
                               Placeholder="Pesquisar por nome ou código..." 
                               PlaceholderColor="{StaticResource TextSecondary}" 
                               TextColor="{StaticResource TextSecondary}" 
                               FontSize="15" 
                               HeightRequest="44"
                               BackgroundColor="Transparent" />
                    </Grid>
                </Border>

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="20,0,0,16">
                    <HorizontalStackLayout Spacing="10" Padding="0,0,20,0">

                        <Border BackgroundColor="{StaticResource BrandSecondary}" StrokeThickness="0" Padding="16,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Label Text="Todos os itens" TextColor="{StaticResource White}" FontSize="14" FontAttributes="Bold" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding FiltrarTodosCommand}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border BackgroundColor="{StaticResource FilterInactiveBackground}" Stroke="{StaticResource BrandPrimary}" StrokeThickness="1" Padding="16,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Label Text="Indisponíveis" TextColor="{StaticResource BrandPrimary}" FontSize="14" FontAttributes="Bold" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding FiltrarIndisponivelCommand}" />
                            </Border.GestureRecognizers>
                        </Border>

                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>

            <Grid Grid.Row="1">
                <ActivityIndicator IsVisible="{Binding EstaCarregando}" 
                                   IsRunning="{Binding EstaCarregando}" 
                                   Color="{StaticResource BrandPrimary}" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center" 
                                   ZIndex="2"/>

                <CollectionView ItemsSource="{Binding PecasEstoque}" Margin="20,0,20,80">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ItemEstoqueModel">
                            <controls:ItemEstoqueCard />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <Border BackgroundColor="{StaticResource CartButtonColor}" 
                StrokeThickness="0" 
                WidthRequest="130" 
                HeightRequest="48"
                HorizontalOptions="End" 
                VerticalOptions="End" 
                Margin="0,0,20,20"
                IsVisible="{Binding TemItensNoCarrinho}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#0F172A" Offset="0,4" Radius="10" Opacity="0.15" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding IrParaCarrinhoCommand}" />
            </Border.GestureRecognizers>

            <Grid ColumnDefinitions="*, Auto" Padding="16,0">
                <Label Grid.Column="0" Text="Ver Carrinho" TextColor="{StaticResource White}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Start"/>
                <Border Grid.Column="1" BackgroundColor="{StaticResource White}" StrokeThickness="0" WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="11"/>
                    </Border.StrokeShape>
                    <Label Text="{Binding QuantidadeCarrinho}" TextColor="{StaticResource CartButtonColor}" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

    </Grid>
</ContentPage>