<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Almoxarifado.App.ViewModels"
             x:Class="Almoxarifado.App.Views.PerfilPage"
             x:DataType="vm:PerfilViewModel"
             BackgroundColor="#F4F6F8"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <Grid HeightRequest="130" BackgroundColor="#1A336E" Padding="20,40,20,15">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="Almoxarifado SG" FontSize="14" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" Opacity="0.8"/>
                    <Label Text="Meu Perfil" FontSize="24" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Grid>

            <Border Margin="0,20,0,14"
                Padding="7"
                BackgroundColor="#D9D9D9"
                Stroke="#D9D9D9"
                StrokeThickness="0"
                HorizontalOptions="Center">
                <Border.StrokeShape>
                        <RoundRectangle CornerRadius="80" />
                    </Border.StrokeShape>
                <Border Padding="28"
                    BackgroundColor="#F2F2F2"
                    Stroke="#F2F2F2"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="70" />
                    </Border.StrokeShape>
                    <Label Text="{Binding Iniciais}"
                   FontSize="60"
                   FontAttributes="Bold"
                   TextColor="#1A336E"
                   HorizontalTextAlignment="Center" />
                </Border>
            </Border>

            <Label Text="{Binding UsuarioAtual.Nome}" FontSize="22" FontAttributes="Bold" TextColor="#1A1A1A" HorizontalOptions="Center"/>
            <Label Margin="0,5,0,30" Text="{Binding UsuarioAtual.Tipo}" FontSize="16" FontAttributes="Bold" TextColor="#757575" HorizontalOptions="Center"/>

            <Border Margin="28,0"
                Padding="20"
                BackgroundColor="White"
                Stroke="{StaticResource BrandSecondary}"
                StrokeThickness="1.5">
                <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource BlackBrush}" Offset="0,4" Radius="12" Opacity="0.08" />
                    </Border.Shadow>
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="E-mail" FontSize="12" TextColor="#254A9A" FontAttributes="Bold"/>
                        <Label Text="{Binding UsuarioAtual.Email}" FontSize="15" TextColor="#444" FontAttributes="Bold"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray100}" HorizontalOptions="Fill" />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Setor / Departamento" FontSize="12" TextColor="#254A9A" FontAttributes="Bold"/>
                        <Label Text="{Binding UsuarioAtual.Setor}" FontSize="15" TextColor="#444" FontAttributes="Bold"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray100}" HorizontalOptions="Fill" />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="ID de Acesso (UID)" FontSize="12" TextColor="#254A9A" FontAttributes="Bold"/>
                        <Label Text="{Binding UsuarioAtual.Id}" FontSize="13" TextColor="#757575"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Margin="28,32,28,24" Spacing="14">

                <Button Text="GERENCIAR FILA"
                    IsVisible="{Binding IsAlmoxarife}"
                    Command="{Binding VoltarParaFilaCommand}"
                    HeightRequest="55"
                    CornerRadius="16"
                    TextColor="White"
                    FontAttributes="Bold">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2A4D85" Offset="0.0" />
                        <GradientStop Color="#1A3160" Offset="1.0" />
                    </LinearGradientBrush>
                </Button.Background>
                <Button.Shadow>
                    <Shadow Brush="#1A3160" Offset="0,6" Radius="14" Opacity="0.35" />
                </Button.Shadow>
                </Button>

                <Button Text="VOLTAR PARA HOME"
                    IsVisible="{Binding IsColaborador}"
                    Command="{Binding VoltarParaHomeCommand}"
                    HeightRequest="55"
                    CornerRadius="16"
                    TextColor="White"
                    FontAttributes="Bold">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2A4D85" Offset="0.0" />
                            <GradientStop Color="#1A3160" Offset="1.0" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Shadow>
                        <Shadow Brush="#1A3160" Offset="0,6" Radius="14" Opacity="0.35" />
                    </Button.Shadow>
                </Button>

                <Button Text="SAIR DA CONTA"
                        Command="{Binding SairCommand}"
                        HeightRequest="55"
                        CornerRadius="16"
                        BackgroundColor="#DA0004"
                        TextColor="White"
                        FontAttributes="Bold">
                    <Button.Shadow>
                        <Shadow Brush="#DA0004" Offset="0,6" Radius="14" Opacity="0.35" />
                    </Button.Shadow>
                </Button>
            </VerticalStackLayout>

            <Grid BackgroundColor="#1A336E" HeightRequest="51" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>