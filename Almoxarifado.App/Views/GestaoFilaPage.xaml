<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Almoxarifado.App.ViewModels"
             xmlns:models="clr-namespace:Almoxarifado.App.Models"
             x:Class="Almoxarifado.App.Views.GestaoFilaPage"
             x:DataType="vm:GestaoFilaViewModel"
             Title="Gestão de Fila"
             BackgroundColor="#F8FAFC"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <Grid Grid.Row="0" BackgroundColor="#1E3A8A" ColumnDefinitions="*, Auto" Padding="20,45,20,20">
            <Label Grid.Column="0" Text="Gestão de Fila" FontSize="24" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />

            <Border Grid.Column="1" WidthRequest="42" HeightRequest="42" BackgroundColor="#EFF6FF" StrokeThickness="1" Stroke="#DBEAFE" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="21" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding IrParaPerfilCommand}" />
                </Border.GestureRecognizers>
                <Label Text="{Binding IniciaisUsuario}" FontAttributes="Bold" TextColor="#1E3A8A" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <VerticalStackLayout Grid.Row="1" Padding="20,20,20,12" Spacing="16">
            <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="14,0" HeightRequest="46">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto, *">
                    <Image Grid.Column="0" VerticalOptions="Center" Margin="0,0,10,0" WidthRequest="18" HeightRequest="18">
                        <Image.Source>
                            <FontImageSource FontFamily="OpenSansRegular" Glyph="🔍" Color="#64748B" Size="16"/>
                        </Image.Source>
                    </Image>
                    <Entry Grid.Column="1" Text="{Binding TextoPesquisa}" Placeholder="Pesquisar por peça, SKU ou status..." PlaceholderColor="#94A3B8" TextColor="#0F172A" VerticalOptions="Center" FontSize="15" BackgroundColor="Transparent"/>
                </Grid>
            </Border>

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Todos" Command="{Binding MudarFiltroCommand}" CommandParameter="Todos" BackgroundColor="#64748B" TextColor="White" FontAttributes="Bold" FontSize="13" CornerRadius="20" HeightRequest="36" Padding="16,0" />
                    <Button Text="Pendentes" Command="{Binding MudarFiltroCommand}" CommandParameter="Pendente" BackgroundColor="#F97316" TextColor="White" FontAttributes="Bold" FontSize="13" CornerRadius="20" HeightRequest="36" Padding="16,0"/>
                    <Button Text="Aprovadas" Command="{Binding MudarFiltroCommand}" CommandParameter="Aprovada" BackgroundColor="#254A9A" TextColor="White" FontAttributes="Bold" FontSize="13" CornerRadius="20" HeightRequest="36" Padding="16,0"/>
                    <Button Text="Recusadas" Command="{Binding MudarFiltroCommand}" CommandParameter="Recusada" BackgroundColor="#EF4444" TextColor="White" FontAttributes="Bold" FontSize="13" CornerRadius="20" HeightRequest="36" Padding="16,0"/>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <Grid Grid.Row="2" Margin="20,4,20,0">
            <CollectionView ItemsSource="{Binding FilaAchatada}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" Padding="0,40">
                        <Image Source="empty_box.png" WidthRequest="80" HeightRequest="80" Opacity="0.4" HorizontalOptions="Center"/>
                        <Label Text="Nenhuma solicitação encontrada por aqui." TextColor="#64748B" FontSize="15" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FilaItemModel">
                        <Border Margin="0,0,0,12" Padding="16" BackgroundColor="White" StrokeThickness="1" Stroke="#E2E8F0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#0F172A" Opacity="0.03" Offset="0,2" Radius="4" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GestaoFilaViewModel}}, Path=AnalisarSolicitacaoCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding NomeProduto}" FontAttributes="Bold" TextColor="#0F172A" FontSize="15" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Sku, StringFormat='SKU: {0}'}" TextColor="#64748B" FontSize="12" />
                                    <Label Text="{Binding UsuarioSolicitante, StringFormat='Por: {0}'}" TextColor="#1E3A8A" FontSize="12" FontAttributes="Bold" Margin="0,2,0,0"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End" Spacing="6">
                                    <Label Text="{Binding Quantidade, StringFormat='{0} un'}" TextColor="#0F172A" FontSize="16" FontAttributes="Bold" HorizontalOptions="End" />
                                    <Border BackgroundColor="#F1F5F9" StrokeThickness="0" Padding="10,4">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Status}" TextColor="#475569" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid BackgroundColor="#80FFFFFF" IsVisible="{Binding IsBusy}" ZIndex="5">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#1E3A8A" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="44" HeightRequest="44" />
            </Grid>
        </Grid>

        <Grid Grid.Row="3" BackgroundColor="#1E3A8A" HeightRequest="56" ColumnDefinitions="*, *">
            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="Fila" TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                <BoxView WidthRequest="4" HeightRequest="4" Color="White" CornerRadius="2" HorizontalOptions="Center" Margin="0,2,0,0"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding IrParaEstoqueCommand}" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="Estoque" TextColor="White" FontSize="14" Opacity="0.6" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>